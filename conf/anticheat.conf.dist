[worldserver]
# Module-owned serial. Do not use the core's unprefixed ConfVersion key.
# Merge template changes before updating this value in your installed config.
Anticheat.ConfVersion = 2026100604
# Copy to anticheat.conf beside worldserver.conf. No automatic punishment exists.
Anticheat.Enable = 1
Anticheat.CheckStaff = 0
Anticheat.Speed = 1
# Experimental aura-based checks: enable only for report-only validation.
# Script-granted flight/waterwalking without an aura can trigger these checks.
Anticheat.Fly = 0
Anticheat.WaterWalk = 0
Anticheat.SpeedMultiplier = 1.30
Anticheat.DistanceSlack = 10.0
Anticheat.GraceMs = 5000
Anticheat.MaximumGapMs = 5000
Anticheat.MaximumLatencyMs = 1000
Anticheat.ReportCooldownMs = 10000
# Optional character database history; import the module SQL before enabling.
Anticheat.DatabaseReports = 0
# Experimental report-only clock acceleration check. Observe for a complete
# server-time window; tolerate batching and reset after long gaps/teleports.
Anticheat.ClientClock = 0
Anticheat.ClockRatio = 1.50
Anticheat.ClockWindowMs = 10000
Anticheat.ClockSlackMs = 2000
# Allow administrators to opt in with .anticheat alerts on (per login session).
# Maximum five messages/second; queue holds 100 reports and expires after 10s.
Anticheat.Alerts = 1
# Experimental traversal heuristics. Report-only; enable individually for testing.
Anticheat.Teleport = 0
Anticheat.Jump = 0
Anticheat.Climb = 0
# Horizontal displacement must exceed both this threshold and the speed envelope.
Anticheat.TeleportDistance = 50.0
# Repeated jump must rise this far above the preceding jump and be off the ground.
Anticheat.JumpRise = 2.0
# Grounded ascent over at least 500ms must exceed both rise and rise/run slope.
Anticheat.ClimbRise = 5.0
Anticheat.ClimbSlope = 3.0
# Minimum time between terrain queries, including jump packets; clamped to >=100ms.
Anticheat.TerrainIntervalMs = 250
